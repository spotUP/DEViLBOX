+}
+
+// DEViLBOX: per-channel taps. Each read call's taps, converted the way the mix is (fixed point to
+// float, then the master gain), so a tap is its channel's share of what read_float_stereo returned.
+void module_impl::enable_channel_taps( std::int32_t count ) {
+	const std::size_t n = static_cast<std::size_t>( std::clamp( count, std::int32_t( 0 ), static_cast<std::int32_t>( m_sndFile->GetNumChannels() ) ) );
+	m_sndFile->m_channelTaps.assign( n, OpenMPT::CSoundFile::ChannelTap{} );
+	m_channelTapOut.assign( n, std::vector<float>() );
+	if ( n == 0 ) {
+		m_sndFile->m_channelTapSink = nullptr;
+		return;
+	}
+	m_sndFile->m_channelTapSink = [this]( const std::vector<OpenMPT::CSoundFile::ChannelTap> & taps, OpenMPT::samplecount_t frames ) {
+		const float factor = 1.0f / static_cast<float>( 1 << OpenMPT::MIXING_FRACTIONAL_BITS );
+		const std::size_t n = static_cast<std::size_t>( frames ) * 2;
+		for ( std::size_t ch = 0; ch < taps.size() && ch < m_channelTapOut.size(); ++ch ) {
+			std::vector<float> & out = m_channelTapOut[ch];
+			const std::size_t at = out.size();
+			out.resize( at + n );
+			float * dst = out.data() + at;
+			const OpenMPT::mixsample_t * src = taps[ch].buffer;
+			if ( m_Gain == 1.0f ) {
+				for ( std::size_t i = 0; i < n; ++i ) dst[i] = static_cast<float>( src[i] ) * factor;
+			} else {
+				for ( std::size_t i = 0; i < n; ++i ) dst[i] = static_cast<float>( src[i] ) * factor * m_Gain;
+			}
+		}
+	};
+}
+std::size_t module_impl::read_channel_tap( std::int32_t channel, std::size_t count, float * left, float * right ) const {
+	if ( channel < 0 || static_cast<std::size_t>( channel ) >= m_channelTapOut.size() ) {
+		return 0;
+	}
+	const std::vector<float> & tap = m_channelTapOut[channel];
+	const std::size_t frames = std::min( count, tap.size() / 2 );
+	for ( std::size_t i = 0; i < frames; ++i ) {
+		left[i] = tap[2 * i];
+		right[i] = tap[2 * i + 1];
+	}
+	return frames;
 }
 
