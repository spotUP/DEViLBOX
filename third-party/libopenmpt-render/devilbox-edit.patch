+// DEViLBOX: in-place edit API (mirrors the soundlib bridge mutators)
+int module_impl::edit_set_pattern_cell( std::int32_t pattern, std::int32_t row, std::int32_t channel, std::int32_t note, std::int32_t instr, std::int32_t volcmd, std::int32_t vol, std::int32_t command, std::int32_t param ) {
+	if ( pattern < 0 || row < 0 || channel < 0 ) return 0;
+	const OpenMPT::PATTERNINDEX pat = static_cast<OpenMPT::PATTERNINDEX>( pattern );
+	if ( !m_sndFile->Patterns.IsValidPat( pat ) ) return 0;
+	if ( static_cast<OpenMPT::ROWINDEX>( row ) >= m_sndFile->Patterns[pat].GetNumRows() || static_cast<OpenMPT::CHANNELINDEX>( channel ) >= m_sndFile->GetNumChannels() ) return 0;
+	OpenMPT::ModCommand * m = m_sndFile->Patterns[pat].GetpModCommand( static_cast<OpenMPT::ROWINDEX>( row ), static_cast<OpenMPT::CHANNELINDEX>( channel ) );
+	if ( !m ) return 0;
+	m->note = static_cast<OpenMPT::ModCommand::NOTE>( note );
+	m->instr = static_cast<OpenMPT::ModCommand::INSTR>( instr );
+	m->volcmd = static_cast<OpenMPT::VolumeCommand>( volcmd );
+	m->vol = static_cast<OpenMPT::ModCommand::VOL>( vol );
+	m->command = static_cast<OpenMPT::EffectCommand>( command );
+	m->param = static_cast<OpenMPT::ModCommand::PARAM>( param );
+	return 1;
+}
+int module_impl::edit_set_order_pattern( std::int32_t order, std::int32_t pattern ) {
+	if ( order < 0 ) return 0;
+	const OpenMPT::ORDERINDEX idx = static_cast<OpenMPT::ORDERINDEX>( order );
+	if ( idx >= m_sndFile->Order().GetLength() ) {
+		m_sndFile->Order().resize( idx + 1 );
+	}
+	m_sndFile->Order()[idx] = static_cast<OpenMPT::PATTERNINDEX>( pattern );
+	return 1;
+}
+int module_impl::edit_set_num_orders( std::int32_t num_orders ) {
+	if ( num_orders < 0 ) return 0;
+	m_sndFile->Order().resize( static_cast<OpenMPT::ORDERINDEX>( num_orders ) );
+	return 1;
+}
+int module_impl::edit_resize_pattern( std::int32_t pattern, std::int32_t rows ) {
+	if ( rows < 1 || rows > 1024 ) return 0;
+	const OpenMPT::PATTERNINDEX pat = static_cast<OpenMPT::PATTERNINDEX>( pattern );
+	if ( pattern < 0 || !m_sndFile->Patterns.IsValidPat( pat ) ) return 0;
+	return m_sndFile->Patterns[pat].Resize( static_cast<OpenMPT::ROWINDEX>( rows ) ) ? 1 : 0;
+}
+std::int32_t module_impl::edit_add_pattern( std::int32_t rows ) {
+	if ( rows < 1 ) return -1;
+	const OpenMPT::PATTERNINDEX pat = m_sndFile->Patterns.InsertAny( static_cast<OpenMPT::ROWINDEX>( rows ) );
+	return ( pat == OpenMPT::PATTERNINDEX_INVALID ) ? -1 : static_cast<std::int32_t>( pat );
+}
+int module_impl::edit_set_initial_speed( std::int32_t speed ) {
+	m_sndFile->Order().SetDefaultSpeed( static_cast<std::uint32_t>( speed ) );
+	return 1;
+}
+int module_impl::edit_set_initial_tempo( std::int32_t tempo ) {
+	m_sndFile->Order().SetDefaultTempoInt( static_cast<std::uint32_t>( tempo ) );
+	return 1;
+}
+int module_impl::edit_set_midi_macro( std::int32_t index, const char * macro ) {
+	if ( index < 0 || index >= 128 || !macro ) return 0;
+	m_sndFile->m_MidiCfg.Zxx[static_cast<std::size_t>( index )] = std::string_view( macro );
+	return 1;
+}
+
