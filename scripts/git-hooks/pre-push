#!/usr/bin/env bash
# DEViLBOX pre-push — full gate (~125 s, deterministic).
#
# Push to `main` triggers Hetzner deploy + GitHub Actions. Block here
# before the slow remote path fails.
#
# Runs SERIALLY, fail-fast. The jobs used to run in parallel, but on an
# 8-core box type-check (tsc) and test:ci (vitest) EACH spawn ~8 worker
# threads — 16+ threads thrashing 8 cores oversubscribes the CPU so badly
# that a 65 s job can balloon past 5 min or hang. Those false timeouts were
# the "pushing takes forever" retries. Serial is slower on paper (~125 s vs
# a 65 s happy path) but deterministic and never retries, so it wins in
# practice. Fail-fast: type-check first (cheap signal), then the suites.
#
#   - `npm run type-check`      (tsc -b --force)   ~58 s
#   - `npm run test:ci`         (vitest)           ~65 s
#   - `npm run test:compliance` (tracker fx)       ~2 s
#
# SNAPSHOT: the gate tests the commit being pushed, never the working tree.
# Each pushed sha is checked out in a throwaway --shared clone that
# reuses this checkout's node_modules and is removed on every exit path, so
# other agents' unfinished edits cannot fail the push and a green gate really
# describes the pushed commit. The extraction adds its own time to the gate.
#
# DOCUMENTATION-ONLY FAST PATH: a push whose every changed file is `*.md`,
# `thoughts/**` or `docs/**` skips all three. Markdown cannot break tsc or
# vitest, and publishing a handoff should not cost two minutes. Note that
# doc-ish files which are actually COMPILED (src/data/manualChapters.ts) are
# `.ts` and correctly take the full gate.
#
# The check is deliberately conservative — it skips only when the pushed
# range can be positively enumerated and every path in it is documentation.
# A new branch, an unknown remote sha, an empty range or any doubt runs the
# full gate.
#
# Bypass in emergencies with `git push --no-verify`. Don't make a habit
# of it — this is the same gate CI runs.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if [ -t 2 ]; then
  RED=$'\033[31m'; GRN=$'\033[32m'; YLW=$'\033[33m'; RST=$'\033[0m'
else
  RED=''; GRN=''; YLW=''; RST=''
fi

# Run one job; on failure print its captured log and abort the push.
run_step() {
  local name=$1; shift
  echo "${YLW}[pre-push] ${name}…${RST}" >&2
  local log; log="$(mktemp)"
  if "$@" > "$log" 2>&1; then
    echo "${GRN}[pre-push] ${name} ok${RST}" >&2
    rm -f "$log"
  else
    local code=$?
    echo "${RED}[pre-push] ${name} failed (exit ${code}):${RST}" >&2
    cat "$log" >&2
    rm -f "$log"
    echo "${RED}[pre-push] blocked — fix the failures above or push with --no-verify.${RST}" >&2
    exit 1
  fi
}

# The pre-push protocol arrives on stdin; read it once so both the docs-only
# check and the commit-to-test selection can use it.
PUSH_REFS=""
[ -t 0 ] || PUSH_REFS="$(cat)"

is_docs_path() {
  case "$1" in
    *.md|thoughts/*|docs/*) return 0 ;;
    *) return 1 ;;
  esac
}

# True only when every file in the pushed range is documentation.
# Reads the pre-push protocol on stdin: <local ref> <local sha> <remote ref> <remote sha>
docs_only_push() {
  local zero='0000000000000000000000000000000000000000'
  local saw_any=0
  local _lref local_sha _rref remote_sha files f

  # Interactive invocation (no ref list piped in) — cannot scope, so gate.
  [ -n "$PUSH_REFS" ] || return 1

  while read -r _lref local_sha _rref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    [ "$local_sha" = "$zero" ] && continue            # deleting a ref: nothing to test
    [ -n "${remote_sha:-}" ] || return 1
    [ "$remote_sha" = "$zero" ] && return 1           # new branch: range is unknown
    git rev-parse -q --verify "${remote_sha}^{commit}" >/dev/null 2>&1 || return 1
    files="$(git diff --name-only "$remote_sha" "$local_sha")" || return 1
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      saw_any=1
      is_docs_path "$f" || return 1
    done <<< "$files"
  done <<< "$PUSH_REFS"

  [ "$saw_any" = 1 ]
}

if docs_only_push; then
  echo "${GRN}[pre-push] documentation-only push — skipping the code gate.${RST}" >&2
  echo "${GRN}[pre-push] (every changed path is *.md / thoughts/ / docs/)${RST}" >&2
  exit 0
fi

# The gate tests the commit being pushed, never the working tree: several
# agents edit the tree all day, and their unfinished edits must not fail (or
# falsely pass) the push. Each pushed commit is materialised into a temporary
# directory (a throwaway --shared clone: no worktree, no index or ref changes here) that
# reuses this checkout's node_modules, and removed again on every exit path.
SNAP_LABEL=pre-push
# shellcheck source=snapshot.sh
. scripts/git-hooks/snapshot.sh
install_snapshot_traps

# Commits to test: every distinct non-delete local sha of the push; HEAD when
# invoked by hand with no ref list.
# The push gate runs what the pushed commits can reach, not the whole suite:
# type-check, then the tests affected by the files changed since the remote
# ref (scripts/git-hooks/affected-tests.mjs: sibling suites + tests that read
# a changed file's source). The fast tier (test:ci) and the nightly heavy tier
# run in CI, which blocks the deploy. A ref with no known remote base (new
# branch, interactive run) falls back to the fast tier.
# Owner 2026-10-11: a gate that ran the whole suite on the laptop took 25 min
# quiet and 1 h 52 min under load, and failed on load-only timeouts.
ZERO=0000000000000000000000000000000000000000
SHAS=""
BASES=""   # "local_sha:remote_sha" pairs (bash 3.2 has no associative arrays)
if [ -n "$PUSH_REFS" ]; then
  while read -r _l lsha _r rsha; do
    [ -n "${lsha:-}" ] || continue
    [ "$lsha" = "$ZERO" ] && continue
    case " $SHAS " in *" $lsha "*) ;; *) SHAS="$SHAS $lsha" ;; esac
    if [ -n "${rsha:-}" ] && [ "$rsha" != "$ZERO" ] && git rev-parse -q --verify "${rsha}^{commit}" >/dev/null 2>&1; then
      BASES="$BASES $lsha:$rsha"
    fi
  done <<< "$PUSH_REFS"
else
  SHAS="$(git rev-parse HEAD)"
fi

base_of() {
  local pair
  for pair in $BASES; do
    [ "${pair%%:*}" = "$1" ] && { echo "${pair#*:}"; return 0; }
  done
  return 0
}

affected_tests() {
  local base=$1 sha=$2 changed files
  changed="$(git diff --name-only "$base" "$sha")"
  # shellcheck disable=SC2086
  files="$(in_snapshot node scripts/git-hooks/affected-tests.mjs --files $changed)"
  if [ -z "$files" ]; then
    echo "no test suite reads the changed files"
    return 0
  fi
  echo "$files"
  # shellcheck disable=SC2086
  in_snapshot env VITEST_TIER=fast npx vitest run --config vite.config.ts --passWithNoTests $files
}

for sha in $SHAS; do
  materialise "$sha"
  base="$(base_of "$sha")"
  run_step "type-check"      in_snapshot npm run --silent type-check
  if [ -n "$base" ]; then
    run_step "affected tests"  affected_tests "$base" "$sha"
  else
    run_step "test:ci (no remote base)" in_snapshot npm run --silent test:ci
  fi
  run_step "test:compliance" in_snapshot npm run --silent test:compliance
  cleanup_snapshot
done

echo "${GRN}[pre-push] all checks passed${RST}" >&2
