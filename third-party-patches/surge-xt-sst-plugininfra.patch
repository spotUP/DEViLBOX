+/*
+ * misc_wasm.cpp — Emscripten/WASM stubs for sst-plugininfra
+ *
+ * Provides no-op/minimal implementations of platform functions
+ * that are not applicable in a browser/worker environment.
+ */
+
+#include <sst/plugininfra/misc_platform.h>
+#include <string>
+
+namespace sst
+{
+namespace plugininfra
+{
+namespace misc_platform
+{
+bool isDarkMode() { return true; }
+void allocateConsole() {}
+std::string toOSCase(const std::string &text) { return text; }
+std::string stackTraceToString(int depth) { return "(stack trace unavailable in WASM)"; }
+std::string getLastSystemError() { return ""; }
+} // namespace misc_platform
+} // namespace plugininfra
+} // namespace sst
