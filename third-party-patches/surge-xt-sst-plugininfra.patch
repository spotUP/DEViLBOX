@@ -0,0 +1,40 @@
+/*
+ * paths_wasm.cpp — Emscripten/WASM stubs for sst-plugininfra
+ *
+ * Provides minimal path implementations for a sandboxed WASM environment.
+ * File system operations are meaningless in a browser AudioWorklet,
+ * but the functions must exist for linking.
+ */
+
+#include "filesystem/import.h"
+#include "sst/plugininfra/paths.h"
+#include <string>
+
+namespace sst
+{
+namespace plugininfra
+{
+namespace paths
+{
+fs::path homePath() { return fs::path{"/tmp"}; }
+
+fs::path sharedLibraryBinaryPath() { return fs::path{}; }
+
+fs::path bestDocumentsVendorFolderPathFor(const std::string &vendorName,
+                                          const std::string &productName)
+{
+    if (!vendorName.empty())
+        return fs::path{"/tmp"} / vendorName / productName;
+    return fs::path{"/tmp"} / productName;
+}
+
+fs::path bestLibrarySharedVendorFolderPathFor(const std::string &vendorName,
+                                              const std::string &productName, bool userLevel)
+{
+    if (!vendorName.empty())
+        return fs::path{"/tmp"} / vendorName / productName;
+    return fs::path{"/tmp"} / productName;
+}
+} // namespace paths
+} // namespace plugininfra
+} // namespace sst
