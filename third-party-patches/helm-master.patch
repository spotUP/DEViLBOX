 OpenGLModulationMeter::~OpenGLModulationMeter() { }
 
-void OpenGLModulationMeter::paint(Graphics& g) { }
+void OpenGLModulationMeter::paint(Graphics& g) {
+  if (!modulated_ || !isVisible())
+    return;
+
+  if (rotary_) {
+    // Draw green arc around rotary knob showing modulation range
+    float angle = SynthSlider::rotary_angle;
+    double range = destination_->getMaximum() - destination_->getMinimum();
+    double knob_pct = (destination_->getValue() - destination_->getMinimum()) / range;
+    double mod_pct = mod_percent_;
+    float min_pct = (float)std::min(mod_pct, knob_pct);
+    float max_pct = (float)std::max(mod_pct, knob_pct);
+
+    float start_rad = mopo::utils::interpolate(-angle, angle, min_pct);
+    float end_rad = mopo::utils::interpolate(-angle, angle, max_pct);
+
+    float cx = getWidth() * 0.5f;
+    float cy = getHeight() * 0.5f;
+    float radius = std::min(cx, cy) * 0.9f;
+    float thickness = std::max(1.5f, radius * 0.08f);
+
+    Path arc;
+    arc.addCentredArc(cx, cy, radius, radius, 0.0f,
+                      start_rad + (float)MathConstants<float>::pi * 0.5f,
+                      end_rad + (float)MathConstants<float>::pi * 0.5f,
+                      true);
+
+    g.setColour(Colour::fromFloatRGBA(0.2f, 0.941f, 0.45f, 0.7f));
+    g.strokePath(arc, PathStrokeType(thickness));
+  }
+  else {
+    // Linear slider modulation indicator
+    g.setColour(Colour::fromFloatRGBA(0.2f, 0.941f, 0.45f, 0.5f));
+    double range = destination_->getMaximum() - destination_->getMinimum();
+    double knob_pct = (destination_->getValue() - destination_->getMinimum()) / range;
+    float min_pct = (float)std::min(mod_percent_, knob_pct);
+    float max_pct = (float)std::max(mod_percent_, knob_pct);
+
+    if (destination_->isHorizontal()) {
+      float x1 = min_pct * getWidth();
+      float x2 = max_pct * getWidth();
+      g.fillRect(x1, 0.0f, x2 - x1, (float)getHeight());
+    } else {
+      float y1 = (1.0f - max_pct) * getHeight();
+      float y2 = (1.0f - min_pct) * getHeight();
+      g.fillRect(0.0f, y1, (float)getWidth(), y2 - y1);
+    }
+  }
+}
 
