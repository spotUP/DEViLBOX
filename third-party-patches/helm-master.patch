+
+void OpenGLPeakMeter::paint(Graphics& g) {
+  if (peak_output_ == nullptr)
+    return;
+
+  float val = peak_output_->buffer[left_ ? 0 : 1];
+  float t = val / MAX_GAIN;
+  float level = sqrtf(t);
+  if (level <= 0.001f)
+    return;
+
+  int width = getWidth();
+  int height = getHeight();
+  int meter_width = (int)(level * width);
+  if (meter_width < 1) return;
+
+  // Replicate the shader: 20 bars with green→red gradient
+  const int NUM_BARS = 20;
+  float bar_width_f = (float)meter_width / NUM_BARS;
+
+  for (int bar = 0; bar < NUM_BARS; ++bar) {
+    float x_start = bar * bar_width_f;
+    float x_end = (bar + 1) * bar_width_f;
+    float bar_center = (x_start + x_end) * 0.5f / width;
+
+    // Position in 0..1 range
+    float pos = (float)(bar + 0.5f) / NUM_BARS * level;
+    float r, gr, b;
+    if (pos > 0.4142f) {
+      r = 1.0f;
+      gr = 1.0f - 0.85f * pos;
+      b = 0.2f;
+    } else {
+      r = 0.5f * pos + 0.5f;
+      gr = 1.0f;
+      b = 0.4f;
+    }
+
+    g.setColour(Colour::fromFloatRGBA(r, gr, b, 1.0f));
+    int ix = (int)x_start + 1;
+    int iw = jmax(1, (int)(x_end - 1) - ix);
+    g.fillRect(ix, 0, iw, height);
+  }
+}
