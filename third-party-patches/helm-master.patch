@@ -57,6 +57,35 @@ void OpenGLOscilloscope::paintBackground(Graphics& g) {
     g.drawLine(0, y, width, y);
 }
 
+void OpenGLOscilloscope::paint(Graphics& g) {
+  if (output_memory_ == nullptr)
+    return;
+
+  int width = getWidth();
+  int height = getHeight();
+  float half_height = height * 0.5f;
+
+  Path waveform;
+  for (int i = 0; i < RESOLUTION; ++i) {
+    float memory_spot = (1.0f * i * mopo::MEMORY_RESOLUTION) / RESOLUTION;
+    int memory_index = (int)memory_spot;
+    float remainder = memory_spot - memory_index;
+    float sample = mopo::utils::interpolate(output_memory_[memory_index],
+                                            output_memory_[memory_index + 1],
+                                            remainder);
+    float x = (float)i / (RESOLUTION - 1.0f) * width;
+    float y = half_height - sample * half_height;
+
+    if (i == 0)
+      waveform.startNewSubPath(x, y);
+    else
+      waveform.lineTo(x, y);
+  }
+
+  g.setColour(Colour::fromFloatRGBA(0.04f, 0.8f, 1.0f, 1.0f));
+  g.strokePath(waveform, PathStrokeType(1.0f));
+}
+
 void OpenGLOscilloscope::init(OpenGLContext& open_gl_context) {
   open_gl_context.extensions.glGenBuffers(1, &line_buffer_);
   open_gl_context.extensions.glBindBuffer(GL_ARRAY_BUFFER, line_buffer_);
