# Server configuration
PORT=3001
NODE_ENV=production

# JWT secret (change this to a random string in production!)
JWT_SECRET=change-this-to-a-random-secret-in-production

# CORS origin (your frontend URL)
CORS_ORIGIN=https://devilbox.uprough.net

# Data directory root (where user files are stored)
DATA_ROOT=/var/www/devilbox/data

# Database directory
DB_DIR=/var/www/devilbox/server/data

# Up Rough Demo System checkout; the /api/uprough routes run its tools/*.py scripts
UPROUGH_ROOT=/path/to/Up_Rough_Demo_System

# Module genres from ModArchive tags (GET /api/genre/:key). Server side only, never sent to clients.
MODARCHIVE_API_KEY=
# Requests per calendar month; the key's cap is 10000
MODARCHIVE_MONTHLY_BUDGET=8000
