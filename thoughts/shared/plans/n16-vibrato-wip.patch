+describe('GoatTracker instrument vibrato', () => {
+  // eco-fog voice 3 opens with a GT instrument vibrato (cmp 2, speed 3, held on
+  // every tick-0 frame). Per-frame wavetable portamento rows froze after the
+  // 8-frame program; the instrument vibrato carries the whole note.
+  it('a traced GT vibrato is rebuilt as an instrument vibrato and replays frame-exact', async () => {
+    const trace = traceOf('eco-fog-goattracker2.sid');
+    const notes = segmentNotes(trace.voices, trace.clock).filter((n) => n.voice === 2).sort((a, b) => a.start - b.start);
+    const first = notes[0];
+    const end = notes[1].start;
+    expect(vibratoOf(trace, first, end, 6)).toMatchObject({ cmp: 2, speed: 3, delay: 1 });
+    const built = sidTraceToGoatTracker(trace, 'eco-fog');
+    expect(built.song.instruments.some((i) => i.ptr[3] > 0 && i.vibdelay === 1)).toBe(true);
+    const gt = await createHeadlessGT();
+    const off = built.frameOffset;
+    const all = gt.play(writeGoatTrackerSng(built.song, built.settings), end - off + 4, trace.chips, built.settings.ntsc);
+    const got = all.slice(Math.max(0, -off));
+    const base = Math.max(0, off);
+    let best = 0;
+    for (const lag of [0, 1]) {
+      let hit = 0, n = 0;
+      for (let f = first.start + 2; f < Math.min(end, first.start + 400); f++) {
+        const r = got[f - base - lag];
+        if (!r) continue;
+        n++;
+        if ((r[14] | (r[15] << 8)) === trace.voices[2][f].freq) hit++;
+      }
+      best = Math.max(best, hit / n);
+    }
+    expect(best).toBeGreaterThan(0.95);
+  }, 60000);
+});
