; Minimal Mega Drive shell for the MDSDRV Phase 0 proof (vasmm68k_mot -Fbin -spaces).
; Calls mds_init once, requests sound 1 (prio 3), then mds_update every VINT.
; -DTEMPO=<byte> sets the sequence tempo (F9 dd); mdsdrv.bin must be in the cwd.
WORK	equ	$FF0000			; WSIZE = $3EC (w_track $4C + TSIZE $3A * 16)
FRAMES	equ	$FF1000
	dc.l	$00FFF800,start
	dcb.l	28,idle
	dc.l	vint			; vector 30 ($78) = level 6 VINT
	dcb.l	33,idle
	dc.b	"SEGA MEGA DRIVE "
	dcb.b	224,' '
	dc.b	"JUE             "
start:
	move.w	#$2700,sr
	move.b	$A10001,d0
	andi.b	#$0F,d0
	beq.s	.notmss
	move.l	#'SEGA',$A14000
.notmss:
	lea	$FF0000,a0
	move.w	#$1FFF,d0
.clr:	clr.l	(a0)+
	dbf	d0,.clr
	move.w	#$8004,$C00004
	lea	WORK,a0
	lea	seq,a1
	lea	pcm,a2
	jsr	drv
	lea	WORK,a0
	moveq	#1,d0
	moveq	#3,d1
	jsr	drv+8
	move.w	#$8174,$C00004
	move.w	#$2300,sr
.loop:	bra.s	.loop
vint:	movem.l	d0-a6,-(sp)
	lea	WORK,a0
	jsr	drv+4
	addq.l	#1,FRAMES
	movem.l	(sp)+,d0-a6
idle:	rte
	cnop	0,2
drv:	incbin	"mdsdrv.bin"
	cnop	0,2
seq:	dc.b	$10,$01,$1f,$00
	dc.w	$0003
	dc.w	2
sdtop:	dc.l	pcm_tab-sdtop
	dc.l	bgm1-sdtop
pcm_tab: dc.w	0
fm0:	dc.b	$00,$42,$26,$01, $1f,$1f,$1f,$1f, $11,$0f,$0f,$11, $00,$00,$00,$00
	dc.b	$60,$25,$ff,$1b, $00,$00,$00,$00, $0f,$32,$0b,$00, $3a,$00
psg0:	dc.b	$00,$01
	even
bgm1:	dc.w	tb-bgm1
	dc.b	0,2
	dc.b	$00,$00
	dc.w	t0-tb
	dc.b	$06,$00
	dc.w	t1-tb
tb:	dc.w	fm0-sdtop
	dc.w	psg0-sdtop
t0:	dc.b	$F9,TEMPO,$E1,$00,$E9,$C0,$AF,$17,$B2,$17,$B6,$17,$BB,$17,$FF
t1:	dc.b	$E1,$01,$AF,$17,$B2,$17,$B6,$17,$BB,$17,$FF
	even
pcm:	dcb.b	256,0
